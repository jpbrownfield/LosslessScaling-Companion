{
  "manifest_version": 3,
  "name": "Lossless Scaling Bridge",
  "version": "1.0.0",
  "description": "Automatically triggers Lossless Scaling when videos enter or exit fullscreen.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Lossless Scaling Bridge"
  }
}
